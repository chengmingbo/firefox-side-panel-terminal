{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "0.1.0",
  "version_name": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "chengmingbo",
  "homepage_url": "https://github.com/chengmingbo/firefox-side-panel-terminal",

  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "96": "src/icons/icon-96.png",
    "128": "src/icons/icon-128.png"
  },

  "sidebar_action": {
    "default_title": "__MSG_extensionName__",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "96": "src/icons/icon-96.png"
    }
  },

  "background": {
    "scripts": ["src/background/background.js"],
    "type": "module",
    "persistent": false
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "nativeMessaging",
    "clipboardRead",
    "clipboardWrite",
    "notifications"
  ],

  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "__MSG_cmdToggleSidebar__"
    },
    "new-session": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "__MSG_cmdNewSession__"
    },
    "disconnect": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "__MSG_cmdDisconnect__"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-side-panel-terminal@chengmingbo.github.io",
      "strict_min_version": "115.0"
    }
  }
}
