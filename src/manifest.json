{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "0.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "chengmingbo",
  "homepage_url": "https://github.com/chengmingbo/firefox-side-panel-terminal",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "sidebar_action": {
    "default_title": "__MSG_extensionName__",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "__MSG_cmdToggleSidebar__"
    },
    "new-session": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "__MSG_cmdNewSession__"
    },
    "disconnect": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "__MSG_cmdDisconnect__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-side-panel-terminal@chengmingbo.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
